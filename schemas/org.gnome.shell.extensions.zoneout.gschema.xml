<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.zoneout" path="/org/gnome/shell/extensions/zoneout/">
    <key name="work-interval" type="i">
      <default>15</default>
      <summary>Work interval in minutes</summary>
    </key>
    <key name="auto-close-seconds" type="i">
      <default>20</default>
      <summary>Break popup duration in seconds</summary>
    </key>
    <key name="show-timer" type="b">
      <default>true</default>
      <summary>Show the countdown timer in the top bar</summary>
    </key>
    <key name="long-work-interval" type="i">
      <default>60</default>
      <range min="1" max="480"/>
      <summary>Focused work interval before a long break, in minutes</summary>
    </key>
    <key name="long-break-duration" type="i">
      <default>5</default>
      <range min="1" max="120"/>
      <summary>Long break duration in minutes</summary>
    </key>
    <key name="long-break-mode" type="i">
      <default>1</default>
      <range min="0" max="1"/>
      <summary>How long breaks are displayed</summary>
    </key>
  </schema>
</schemalist>
